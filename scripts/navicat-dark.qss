/* Dark stylesheet for Navicat AppImage on Xfce/Qt.
 * Used by scripts/navicat-darkmode-wrapper.sh.
 */
QWidget {
    background-color: #2b2b2b;
    color: #eeeeee;
}
QMainWindow, QDialog, QFrame, QSplitter, QStackedWidget, QScrollArea {
    background-color: #242424;
    color: #eeeeee;
}
QMenuBar, QMenu, QToolBar, QStatusBar, QTabWidget, QTabBar::tab {
    background-color: #2b2b2b;
    color: #eeeeee;
}
QMenu::item:selected, QTabBar::tab:selected {
    background-color: #3d5f8c;
    color: #ffffff;
}
QLineEdit, QTextEdit, QPlainTextEdit, QTableView, QTreeView, QListView {
    background-color: #1e1e1e;
    color: #eeeeee;
    selection-background-color: #315a8c;
    selection-color: #ffffff;
    border: 1px solid #444444;
}
QPushButton, QComboBox, QToolButton {
    background-color: #3a3a3a;
    color: #eeeeee;
    border: 1px solid #555555;
    padding: 4px;
}
QPushButton:hover, QToolButton:hover, QComboBox:hover {
    background-color: #454545;
}
QHeaderView::section {
    background-color: #333333;
    color: #eeeeee;
    border: 1px solid #444444;
}
QScrollBar {
    background-color: #2b2b2b;
}
QScrollBar::handle {
    background-color: #555555;
}
QToolTip {
    background-color: #111111;
    color: #ffffff;
    border: 1px solid #555555;
}
